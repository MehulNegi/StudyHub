# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local agent state (portable repository exclusions)
/.freebuff/
/.kilo/
/.agents/
/.codex/
/.aws/

# Credentials and private learning documents; publish PDFs through reviewed Storage flows
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
service-account*.json
*.pdf
*.PDF
*.dump
*.backup

# Local diagnostic only: omit raw database output route from Git-based deployments.
# This does not disable the route in builds made from this local working directory.
/app/test-supabase/
